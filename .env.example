#LANGSMITH_API_KEY=<langsmith-api-key>
# Only if your key covers multiple workspaces:
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=pantry-to-plan

#PINECONE_API_KEY=<pinecone-api-key>
PINECONE_INDEX_NAME=pantry-to-plan
PINECONE_NAMESPACE=baseline
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Model-only comparison settings for Nebius Token Factory.
#NEBIUS_API_KEY=<nebius-api-key>
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL_1=Qwen/Qwen3-30B-A3B-Instruct-2507
NEBIUS_MODEL_2=google/gemma-3-27b-it

# Live generation uses the best-balanced E2 Qwen configuration. Provider-neutral
# settings fall back to the NEBIUS_* values above without duplicating the API key.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=gemma3:4b
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_EMBEDDING_DIMENSIONS=512
RETRIEVAL_BACKEND=auto

# Nebius is used automatically when Ollama is unavailable or a local model
# cannot satisfy a request. Existing NEBIUS_MODEL_1/2 values are reused.